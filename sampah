<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Pengelolaan Sampah Kota Cerdas</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Sistem Pengelolaan Sampah Kota Cerdas</h1>
        <form id="sampahForm">
            <div>
                <label for="jenis">Jenis Sampah:</label>
                <input type="text" id="jenis" name="jenis" required>
            </div>
            <div>
                <label for="berat">Berat (kg):</label>
                <input type="number" id="berat" name="berat" required>
            </div>
            <div>
                <label for="tanggalMasuk">Tanggal Masuk:</label>
                <input type="date" id="tanggalMasuk" name="tanggalMasuk" required>
            </div>
            <div>
                <label for="gambar">Unggah Gambar:</label>
                <input type="file" id="gambar" name="gambar" accept="image/*" required>
            </div>
            <button type="submit">Tambah Sampah</button>
        </form>
        <h2>Daftar Sampah</h2>
        <ul id="sampahList" class="sampah-list"></ul>
        <h2>Total Berat Sampah: <span id="totalBerat">0</span> kg</h2>
    </div>
    <script src="script.js"></script>
</body>
</html>
